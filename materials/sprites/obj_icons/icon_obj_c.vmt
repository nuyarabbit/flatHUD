"UnlitGeneric"
{
	"$basetexture"	"vgui/replay/thumbnails/cp/point_c"
	"$translucent" "1"
	"$ignorez" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"Proxies"
	{
		"AnimatedTexture"
			{
				"animatedtexturevar" "$basetexture"
				"animatedtextureframenumvar" "$frame"
				"animatedtextureframerate" "1"
			}
	}
}
