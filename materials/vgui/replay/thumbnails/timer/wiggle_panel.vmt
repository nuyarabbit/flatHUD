"UnlitGeneric"
{
	"$basetexture"	"vgui/replay/thumbnails/timer/wiggle_panel"
	"$color"		"{46 43 42}"
	"$translucent" "1"
	"$ignorez" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"Proxies"
	{
		"AnimatedTexture"
			{
				"animatedtexturevar" "$basetexture"
				"animatedtextureframenumvar" "$frame"
				"animatedtextureframerate" "1"
			}
	}
}
