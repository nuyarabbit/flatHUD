"UnlitGeneric"
{
	"$basetexture"	"vgui/replay/thumbnails/panels/wiggle_panel_mask"
	"$color"		"{201 58 58}"
	"$translucent" "1"
	"$ignorez" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"Proxies"
	{
		"AnimatedTexture"
			{
				"animatedtexturevar" "$basetexture"
				"animatedtextureframenumvar" "$frame"
				"animatedtextureframerate" "1"
			}
	}
}
